# ─────────────────────────────────────────────────────────────
# legal_acps 环境变量模板
# 用法：复制成 .env，填好，然后 chmod 600 .env
#   cp .env.example .env && chmod 600 .env
# ─────────────────────────────────────────────────────────────

# ── 1. 模型（DeepSeek 官方，2026-09 实测可用）────────────────
#   deepseek-v4-pro    推理更强，法律判断用它
#   deepseek-flash     更快更便宜，日常联调用它
OPENAI_MODEL=deepseek-v4-pro
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_API_KEY=sk-在这里填你的key

# ── 2. 平台后端（参加 AIC 大赛必读）─────────────────────────
#   ioa_pub = https://www.ioa.pub        （wit 默认，自测用）
#   wt      = https://wt.ioa.pub         （梧桐平台，AIC 大赛「智能体互联」
#                                          主题赛**指定**的验证平台）
#
# ⚠️ 两套平台是**互相独立的账号库与 Agent 索引**。在 www 注册的 Agent，
#    对比赛不计分（规则原文：「未完成平台验证的作品视为未通过比赛必要
#    验证场景」）。要参赛就把这里设成 wt，并填 wt 的账号。
ACPS_BACKEND=ioa_pub

# ── 3. ACPs 开发者凭据 ──────────────────────────────────────
# 填哪套账号，取决于上面的 ACPS_BACKEND：
#   ACPS_BACKEND=ioa_pub → 填 https://www.ioa.pub/ 的账号
#   ACPS_BACKEND=wt      → 填 https://wt.ioa.pub/ 的账号（比赛用）
# wit 会用它调 POST /api/v1/auth/login 换 token。
ACPS_USERNAME=
ACPS_PASSWORD=

# 梧桐平台的 mTLS 注册端点。官方接入文档只给了 registry/ca/discovery 三个
# base_url，没给 mTLS 端口；这里按 www 侧的约定推定为 9002。
# 若 wt 侧未开放该端口导致注册失败，把它显式设为空串即可禁用。
# ACPS_REGISTRY_MTLS_URL=

# ── 4. 对外地址 ─────────────────────────────────────────────
# 只写主机，端口由 legal_acps/acps_config.py 的 PORTS 按角色自动补：
#   incitement 8443 / harm 8444 / leader 8445 / debate-pro 8446 / debate-con 8447
# 写裸 IP 就行：平台 CA 会把 IP 放进证书 SAN，不需要域名、不需要备案。
ACPS_PUBLIC_HOST=150.109.154.16

# 如果你想给某个角色单独指定完整地址（比如挂反向代理后），改用下面这个，
# 它优先级更高，且所有角色只能共用一个值——所以要带路径区分时请改代码。
# ACPS_PUBLIC_ENDPOINT=https://acps-legal.example.com:8443

# ── 5. 可选 ─────────────────────────────────────────────────
# 机构名会进 ACS 的 provider.organization，并可能出现在平台截图/演示视频里。
# 比赛材料要求不出现学校名称/LOGO：这里用中性名，不要填学校名。
ACPS_ORG=LegalAgent-Demo
ACPS_COUNTRY=CN
ACPS_PROVIDER_NAME=法前哨
OPENAI_TIMEOUT=180
