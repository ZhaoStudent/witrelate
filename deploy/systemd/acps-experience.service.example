# 法前哨 · 体验应用（反诈演练场）systemd 单元模板
#
# 部署：
#   1. 复制为 /etc/systemd/system/acps-experience.service
#   2. 复制 acps-experience.env.example 为 /etc/acps-experience.env
#   3. 把 CHANGE_ME 换成真实口令；chmod 600 /etc/acps-experience.env
#   4. sudo systemctl daemon-reload && sudo systemctl enable --now acps-experience
#
# 说明：
#   - 该服务只跑体验应用，不注册 ACPs、不产生平台访问记录；
#   - 默认监听 0.0.0.0:8090；公网暴露时 EXP_ACCESS_KEY 必须设置；
#   - 口令放 EnvironmentFile，不写进 unit：`systemctl show` 不会读出文件内容。

[Unit]
Description=ACPs Experience - 反诈演练场 Web (DeepSeek-style console, :8090)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/witrelate

Environment=HOME=/home/ubuntu
Environment=PYTHONUNBUFFERED=1
# ⚠️ 真实口令放在 /etc/acps-experience.env（chmod 600），不写进 unit
EnvironmentFile=/etc/acps-experience.env

ExecStart=/home/ubuntu/witrelate/.venv/bin/python -u -m legal_acps.experience.server --host 0.0.0.0 --port 8090

Restart=always
RestartSec=10
LimitNOFILE=65536

StandardOutput=append:/home/ubuntu/witrelate/logs/experience.log
StandardError=append:/home/ubuntu/witrelate/logs/experience.log

[Install]
WantedBy=multi-user.target
