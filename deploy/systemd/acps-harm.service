[Unit]
Description=ACPs Agent - harm-assessor (社会危害性评估 Partner, :8444)
# 本地文档（systemd 的 file:// URL 不接受非 ASCII 路径，
# 百分号编码也不行 —— % 在单元文件里是 specifier 转义符）：
#   /home/ubuntu/witrelate/docs/上线操作手册.md
Documentation=https://wt.ioa.pub/docs.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/witrelate

Environment=HOME=/home/ubuntu
Environment=PYTHONUNBUFFERED=1

# 实测（2026-09-27）：三个进程若"同时"登录 Registry，后登录的会把先前的会话顶掉，
# 表现是后启动的角色打印 blocked / RegistryClientError: Could not validate credentials，
# 而单独启动它又完全正常 —— 是并发登录竞态，不是账号问题。
# 串行 + 间隔即可稳定通过。这里用 ExecStartPre 强制错开，冷启动和崩溃重启都生效。
ExecStartPre=/bin/sleep 12

ExecStart=/home/ubuntu/witrelate/.venv/bin/python -u -m legal_acps.run_agent harm

Restart=always
RestartSec=40
TimeoutStopSec=25
# 启动超时**必须显式给**：systemd 默认 `TimeoutStartSec=90s`，而本单元用来错开
# 登录的 `ExecStartPre=/bin/sleep N` 也算在**启动**操作里。2026-10-04 实测：
# sleep 96（evidence-audio）与 sleep 108（evidence-video）**永远起不来** ——
# journalctl 报 `start-pre operation timed out`，叠加 `Restart=always` 就成了
# 每 60 秒失败一次的死循环。180s 留余量（当前最大 108s）。详见手册 §8.4。
TimeoutStartSec=180
LimitNOFILE=65536

StandardOutput=append:/home/ubuntu/witrelate/logs/harm.log
StandardError=append:/home/ubuntu/witrelate/logs/harm.log

[Install]
WantedBy=multi-user.target
